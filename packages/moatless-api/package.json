{
  "name": "@t3tools/moatless-api",
  "private": true,
  "type": "module",
  "exports": {
    "./customInstance": {
      "types": "./src/customInstance.ts",
      "import": "./src/customInstance.ts"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "import": "./src/generated/index.ts"
    },
    "./generated/model": {
      "types": "./src/generated/model/index.ts",
      "import": "./src/generated/model/index.ts"
    },
    "./generated/*": {
      "types": "./src/generated/*.ts",
      "import": "./src/generated/*.ts"
    }
  },
  "scripts": {
    "generate": "orval",
    "spec:check": "node scripts/checkSpecFreshness.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "orval": "^8.2.0",
    "vite-plus": "catalog:"
  }
}
